<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    {% if include.limit %}
      <!-- Simple table format for about page -->
      <div
        class="table-responsive"
        {% if page.announcements.scrollable and news_size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>

    {% else %}
      <!-- Enhanced format for full news page: year grouping + tags -->
      {% assign current_year = '' %}
      {% for item in news limit: news_limit %}
        {% assign item_year = item.date | date: '%Y' %}

        {% if item_year != current_year %}
          {% assign current_year = item_year %}
          <h2 class="news-year mt-4 mb-3">{{ item_year }}</h2>
        {% endif %}

        <div class="news-item d-flex align-items-start mb-3 pb-3" style="border-bottom: 1px solid var(--global-divider-color);">
          <div class="news-date text-muted me-4" style="min-width: 100px; font-weight: 600; font-size: 0.85rem; padding-top: 2px;">
            {{ item.date | date: '%b %d' }}
          </div>
          <div class="flex-grow-1">
            {% if item.inline %}
              <p class="mb-1">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</p>
            {% else %}
              <a class="news-title d-block mb-1" href="{{ item.url | relative_url }}" style="font-weight: 600;">{{ item.title }}</a>
            {% endif %}
            <!-- Tags and categories -->
            {% assign has_tags = false %}
            {% assign has_cats = false %}
            {% if item.tags and item.tags.size > 0 %}{% assign has_tags = true %}{% endif %}
            {% if item.categories and item.categories.size > 0 %}{% assign has_cats = true %}{% endif %}
            {% if has_tags or has_cats %}
              <p class="post-tags mt-1 mb-0">
                {% if has_tags %}
                  {% for tag in item.tags %}
                    <a href="{{ '/news/tags/' | append: tag | append: '/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }} </a>
                  {% endfor %}
                {% endif %}
                {% if has_cats %}
                  {% for cat in item.categories %}
                    <i class="fa-solid fa-tag fa-sm"></i> {{ cat }}
                  {% endfor %}
                {% endif %}
              </p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
